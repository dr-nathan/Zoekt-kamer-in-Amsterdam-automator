[Unit]
Description=Send personalized Chineur2000 daily digests
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nathan
Group=nathan
WorkingDirectory=/home/nathan/facebookrooms
EnvironmentFile=/home/nathan/facebookrooms/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/nathan/facebookrooms/.venv/bin/fb-housing digest --database /home/nathan/facebookrooms-data/listings.db
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/nathan/facebookrooms-data
